# --- Required -----------------------------------------------------------------
# With `docker compose up db -d` use postgres://qrdirector:qrdirector@localhost:5432/qrdirector
DATABASE_URL=postgres://postgres@localhost:5432/qrdirector
# Public origin of the app; used for short links, QR content and the OAuth redirect URI.
PUBLIC_BASE_URL=http://localhost:5173
# At least 32 random characters, e.g. `openssl rand -base64 48`. Rotating it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- Microsoft Entra ID sign-in ------------------------------------------------
# AUTH_MODE=entra (default) or dev (local only, refused when NODE_ENV=production)
AUTH_MODE=dev
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional restrictions
AUTH_ALLOWED_EMAIL_DOMAINS=
AUTH_REQUIRED_GROUP_ID=

# --- Optional -------------------------------------------------------------------
# PORT=8080
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# DATABASE_SSL=false
# SESSION_TTL_HOURS=12
# TRUST_PROXY_HOPS=1            # Cloud Run = 1, behind an external HTTPS load balancer = 2
# GEOIP_DB_PATH=/data/GeoLite2-City.mmdb
# RAW_IP_RETENTION_DAYS=90      # 0 = keep forever
# HIT_RETENTION_DAYS=0          # 0 = keep forever
# ROOT_REDIRECT_URL=https://www.example.com
# NOT_FOUND_REDIRECT_URL=https://www.example.com
# QR_UPPERCASE_URLS=true
# RUN_MIGRATIONS=true
